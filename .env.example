# Скопируйте в .env и поправьте под себя. .env в git не попадает.

# --- make run / make dev на хосте -------------------------------------------
# Postgres из compose (make db). Формат хостинга postgres:// тоже подходит.
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable
# Базовый адрес для поля short_url.
BASE_URL=http://localhost:8080
# DSN Bugsink; пусто — мониторинг выключен. Получить: make bugsink-project.
SENTRY_DSN=
# Отладочная ручка GET /api/debug/error (только для проверки мониторинга).
ENABLE_DEBUG_ROUTES=false
# Разрешённые origin для CORS через запятую.
CORS_ORIGINS=http://localhost:5173
APP_ENV=development

# --- docker compose ---------------------------------------------------------
# Порт хоста, на котором Caddy отдаёт UI и API.
APP_PORT=8090
# Публичный адрес приложения из compose (попадает в short_url).
APP_BASE_URL=http://localhost:8090
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
DB_PORT=5432
# Локальный Bugsink (профиль monitoring).
BUGSINK_PORT=8000
BUGSINK_ADMIN=admin@example.com:admin
BUGSINK_SECRET_KEY=local-only-bugsink-secret-key-change-me-0123456789abcdef
